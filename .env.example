# Copy to .env and fill in. .env is git-ignored - never commit real passwords.

# Application under test (the API is served from <origin>/api)
BASE_URL=https://cerpoc.regigov.au
# Optional: API base if not <origin of BASE_URL>/api
#API_BASE_URL=

# CER staff accounts (participants / devices scenarios)
CER_ADMIN_USERNAME=
CER_ADMIN_PASSWORD=
CER_OFFICER_USERNAME=
CER_OFFICER_PASSWORD=

# Applicant account (participants scenario, recovery)
APPLICANT_PARTICIPANT_USERNAME=
APPLICANT_PARTICIPANT_PASSWORD=

# Seed accounts used by phase2-phase6 and apisweep (cer.admin, cer.officer, sunvolt.admin,
# sunvolt.user, gridcell.admin) - they all share this password
SANDBOX_SEED_PASSWORD=

# Password given to accounts the tests register (tests/api/auth)
GLOBAL_TEST_PASSWORD=

# Optional read-only account
#READONLY_USERNAME=
#READONLY_PASSWORD=

# Optional - Phase 5 fault injection and partner inbox calls (mock-partners is not exposed on the public sandbox)
#MOCK_PARTNERS_URL=
#PARTNER_API_KEY=
#EXCHANGE_WAIT_DEAD_LETTER=1
#EXCHANGE_RECONCILE_TIMEOUT_MS=
