import { test, expect } from '@playwright/test';
import { loginAs } from '../../utils/login-helper';
import * as TestData from '../../dynamic.data/generate'

  export interface OrganisationDetails {
    legal_name: string;
    trading_name?: string;
    abn: string;
    participant_type: string;
    contact_name: string;
    email: string;
    phone: string;
    address: string;
    address_line_1: string;
    address_line_2?: string;
    suburb: string;
    postcode: string;
    state: string;
  }

  export interface SystemIdentifers {
    cer_id: string;
    cer_lastupdated: string;
    cer_version: string;
    application_status: string;
  }

test('test create installer application', async ({ page }) => {

  // Add the login recording to its own page object
  const role = "applicant_inst";
  const pending_filter = "AUTO-INS"; // this means the new participant will be searchable by type  
  const abn = TestData.getRandomABN();
  const mobile = TestData.getRandomMobileNumber();
  const addressLine2 = TestData.getRandomAddressLine2();
  const address = TestData.getRandomStreetAddress();
  const state = TestData.getRandomState();
  const postcode = TestData.getRandomPostCode(state);
  const suburb = TestData.getRandomSuburb(state, postcode);

  //  default behaviour for new applicant
  await test.step('STEP Login as a new applicant', async() => {});
  loginAs(page, role);

  const continueItRadio = page.getByRole('radio', { name: 'Continue it (submitted)' });

  if (await continueItRadio.isVisible()) {
    throw new Error(
        'Business flow broken: a record exists that is pending when it should already be approved.'
    );
  }

  await test.step('STEP Fill details', async() => {});
  
  // fill legal name field
  await page.getByRole('textbox', { name: 'Legal name' }).click();
  await page.getByRole('textbox', { name: 'Legal name' }).fill(`${pending_filter} Legal ${abn}`);
  //fill optional trading name field
  await page.getByRole('textbox', { name: 'Trading name (optional)' }).click();
  await page.getByRole('textbox', { name: 'Trading name (optional)' }).fill(`${pending_filter} Trading ${abn}`);
  //fill ABN field
  await page.getByRole('textbox', { name: 'ABN 11 digits' }).click();
  await page.getByRole('textbox', { name: 'ABN 11 digits' }).fill(abn); 
  // select participant manufacturer from dropdown
  await page.getByLabel('Participant').selectOption('manufacturer');
    // fill contact name field
  await page.getByRole('textbox', { name: 'Contact name' }).click();
  await page.getByRole('textbox', { name: 'Contact name' }).fill(`${pending_filter} Contact ${abn}`);
  // fill email field
  await page.getByRole('textbox', { name: 'Email' }).click();
  await page.getByRole('textbox', { name: 'Email' }).fill(`AUTO.contact@${abn}.com`);
  // fill phone field
  await page.getByRole('textbox', { name: 'Phone' }).click();
  await page.getByRole('textbox', { name: 'Phone' }).fill(mobile);
  // fill address line 1 field
  await page.getByRole('textbox', { name: 'Address line 1' }).click();

  if ( addressLine2 === '') {
    await page.getByRole('textbox', { name: 'Address line 1' }).fill(address);
  }
  else {
    await page.getByRole('textbox', { name: 'Address line 1' }).fill(addressLine2);
    await page.getByRole('textbox', { name: 'Address line 2 (optional)' }).fill(address);
  }

  // fill suburb field
  await page.getByRole('textbox', { name: 'Suburb' }).click();
  await page.getByRole('textbox', { name: 'Suburb' }).fill(suburb);
  // Select a state from dropdown
  await page.getByLabel('StateACTNSWNTQLDSATASVICWA').selectOption(state);
  
  // fill postcode field, ensure it matches state main city
  await page.getByRole('textbox', { name: 'Postcode' }).click();
  await page.getByRole('textbox', { name: 'Postcode' }).fill(postcode);

  // Declarations
  // 
  await test.step('STEP Confirm Declarations', async() => {});
  
  await page.getByRole('checkbox', { name: 'I am authorised to apply on' }).check();
  await page.getByRole('checkbox', { name: 'The information provided is' }).check(); 
  
  // Add Evidence
  await test.step('STEP Add evidence note for approval', async() => {});
  await page.getByRole('textbox', { name: 'Evidence notes (optional)' }).fill(`Test evidence optional notes Automated for: ${pending_filter} Legal ${abn}`);

  await page.pause();

  // Submit for approval
  await test.step('STEP Add evidence note for approval', async() => {});
  await page.getByRole('button', { name: 'Submit to CER' }).click();

  // Record here ... for confirmation of outcome

});