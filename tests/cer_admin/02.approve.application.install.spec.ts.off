import { test, expect } from '@playwright/test';
import { loginAs } from '../../utils/login-helper';
//import * as TestData from '../../data/generate';

  export interface OrganisationDetails {
    legal_name: string;
    trading_name?: string;
    abn: string;
    participant_type: string;
    contact_name: string;
    email: string;
    phone: string;
    address: string;
    address_line_1: string;
    address_line_2?: string;
    suburb: string;
    postcode: string;
    state: string;
  }

  export interface SystemIdentifers {
    cer_id: string;
    cer_lastupdated: string;
    cer_version: string;
    application_status: string;
  }

test('test approve manufacturer application', async ({ page }) => {

  // Add the login recording to its own page object
  const role = "admin";
  const pending_filter = "AUTO-INS"; // this means the new participant will be searchable by type  
  /*
  const abn = TestData.getRandomABN();
  const mobile = TestData.getRandomMobileNumber();
  const addressLine2 = TestData.getRandomAddressLine2();
  const address = TestData.getRandomStreetAddress();
  const state = TestData.getRandomState();
  const postcode = TestData.getRandomPostCode(state);
  const suburb = TestData.getRandomSuburb(state, postcode);
  */

  //  default behaviour for cer admin
  await test.step('STEP Login as a CER Admin', async() => {});
  loginAs(page, role);

  await page.pause();

  // We should be at the CER workbench on login
  await test.step('STEP Verify CER Workbench is shown', async() =>{});
  await expect(page.locator('h1')).toContainText('CER workbench');

  //
  await test.step('STEP View Participant applications', async() => {});
  
  //Click Participants on Left hand menu or Tile
  await expect(page.getByRole('navigation', { name: 'Workbench' })).toContainText('Participants');// Search results by AUTO-MAN and Status pending
  await page.getByRole('link', { name: 'Participant register' }).click();
  await expect(page.getByRole('heading')).toContainText('Participants'); 
  
  // filter to find pending Manufacturer
  await test.step('STEP Search for Pending Participants', async() =>{});
 
  await page.getByRole('textbox', { name: 'Search' }).click();
  await page.getByRole('textbox', { name: 'Search' }).fill('AUTO-MAN');
  await page.getByLabel('StatusAnypendingapprovedsuspendedrejectedwithdrawn').selectOption('pending');

  // Select first item in the list returned

  await expect( page.locator('tbody tr')).toHaveCount(1);

  const isPending = await page.getByRole('link', {name: /^AUTO-MAN Legal/i }).isVisible();

  if (!isPending) {
    throw new Error(
        'Dependency missing: An "AUTO-INS Legal" Organisation must be pending approval before this test can run.'
    );
  }
  
  // Click Open the applications queue
  //NOTE: The feature to search applications by abn  or org name is not availhble here
  await page.getByRole('link', { name: 'Open the applications queue' }).click();

  // Find the pending record and click the first Organisation list

  await page.getByRole('link', {name: /^AUTO-INS Legal/i }).first().click();

  // Add an assessment note
  await expect(page.getByRole('main')).toContainText('Assessment notes');
  await expect(page.getByRole('main')).toContainText('Add assessment note');

  //Extract fields from application an Organisation and adda s noteawait page.getByRole('textbox', { name: 'Add assessment note' }).click();

  const legalName = await page.locator('dt:text-is("Legal name") + dd').textContent();
  if (!legalName) {
    throw new Error('Legal name is missing');
  }

  const address = await page.locator('dt:text-is("Address") + dd').textContent();
  const applicationId = await page.locator('dt:text-is("Application ID") + dd').textContent();
  const participantId = await page.locator('dt:text-is("Participant ID") + dd').textContent();

  await page.getByRole('textbox', { name: 'Add assessment note' }).fill(`Name: ${legalName}\nAddress: ${address}\nApplication ID: ${applicationId}\nParticipant ID:  ${participantId}`);
  // Click Add Note - this will create a new empty note - is this expected or reversible 
  await page.getByText('Add assessment noteName: AUTO').click();

//Verify Decision Approve is available and checked
const activeRadioButton = page.getByRole('radio', { name: 'Approve' });

if (!(await activeRadioButton.isChecked())) {
    await activeRadioButton.check();
}

// Add a Reason for audit trail

await page.getByRole('textbox', { name: 'Reason (recorded on the' }).click();
await page.getByRole('textbox', { name: 'Reason (recorded on the' }).fill('This an automated approval by Playwright');
  
// Record decision
await page.getByRole('button', { name: 'Record decision' }).click();

// Record here ... for confirmation of outcome
await page.locator('span').filter({ hasText: 'approved' }).click();

// Click Participants
// Search for Organisation 
// Check status is APPROVED

await page.getByRole('navigation', { name: 'Workbench' }).getByRole('link', { name: 'Participants' }).click();
await page.getByRole('textbox', { name: 'Search' }).click();
await page.getByRole('textbox', { name: 'Search' }).fill(legalName);
await expect (page.getByRole('cell', { name: 'approved' }).locator('span')).toBeVisible();

});